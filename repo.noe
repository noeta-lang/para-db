// para.db.repo — the repository + unit-of-work layer (aether DB2), pure Noeta over the DB1 query
// builder (`para.db.query`) and the DB0 native driver (`para.db`).
//
// A `Repository<T>` maps rows (a `Map<string, dyn>` per row) to and from typed model structs by
// reflection over JSON:
//   * row -> model:  `json.decode_typed(model_name, json.stringify(row))` narrowed back to `T`,
//                    where the model derives `@derive(Deserialize<Json>)`.
//   * model -> row:  `json.parse(entity.to_json())` (a `Map<string, dyn>` whose keys are the
//                    columns), where the model derives `@derive(Serialize<Json>)`.
// Both halves read the type argument off the instance: an instance records its type arguments at
// construction, so `type_name::<T>()` inside a method answers the qualified identity the name-keyed
// decode registry holds, and `.as<T>()` in the same position narrows the decoded value back to the
// model. The entire mapping therefore lives inside the repository, and NO caller casts.
//
// The unit-of-work is the advanced feature: `add`/`save`/`remove` STAGE inserts/updates/deletes
// during a request; `flush` commits them as one batch inside a single transaction (BEGIN … COMMIT),
// then clears the pending lists. Reads (`find`/`all`/`where`) go straight to the connection.
//
// Both surfaces are typed as the model. Writes take it — `add(entity: T)` / `save(entity: T)`, staged
// into `List<T>` — so handing a repository the wrong model is an E0007 at the call site rather than a
// malformed row at flush time. Reads answer it: `find` -> `?T`, `all`/`where` -> `List<T>`.
// `remove(id: dyn)` is the one `dyn` on this class, on purpose: it takes a primary-key VALUE, not a
// model, and a key's type is not the repository's type argument.
//
// A row that does not decode to a `T` ABORTS the program, naming the model, the table, the column and
// the types that disagree. It is never dropped and never handed back untyped. Once the driver presents
// each column as its declared type (a `BOOLEAN` column is a `bool`, not SQLite's stored 0/1), a row
// that still will not decode means the TABLE and the MODEL genuinely disagree — a migration that did
// not run, or a deployment carrying a model the schema has never matched. That is a defect the
// developer has to see, and the shortened list it used to produce (`find` answering `none`,
// `all`/`where` quietly returning fewer rows than the table holds) is indistinguishable from a
// correct empty answer. A plausible wrong answer travelling silently is worse than a loud stop, so
// the read surface stays `List<T>`/`?T` — `none` means "no such row" and nothing else — and the
// disagreement is reported where it happens. `try_map_row` is the recoverable twin, for the caller who
// reads a table it does not own — the standard aborting/recoverable door pair, identical message on
// both halves.

use para.db.Connection
use db.query.{table, run, exec, Query}
use std.json

// A repository over one model + table. The model is the type argument; construct it at a concrete
// instantiation, naming its table and its primary-key column:
//
//   users: Repository<User> = Repository.new("users", "id")
//
// The annotation is what records the instantiation, and it is load-bearing: `T` rides on the
// instance, so `type_name::<T>()` inside a method (see `model`) recovers the model's QUALIFIED
// runtime identity — the key the JSON decode registry holds. A model declared under a `namespace`
// therefore needs no hand-written `"app.storage.User"`, and a rename cannot desynchronize it.
pub class Repository<T> {
    pub tbl: string // the backing table (also a NOTIFY channel name, for the reactive layer)
    pub pk: string // the primary-key column
    mut model_name: string // memo of `type_name::<T>()` — empty until the first `model()`
    mut pending_new: List<T> // staged inserts (whole entities)
    mut pending_dirty: List<T> // staged updates (whole entities)
    mut pending_remove: List<dyn> // staged deletes (primary-key VALUES, not models)

    fn new(tbl: string, pk: string): Repository<T> {
        return Repository {
            tbl: tbl,
            pk: pk,
            model_name: "",
            pending_new: [],
            pending_dirty: [],
            pending_remove: [],
        }
    }

    // The model's qualified runtime type name, read off this repository's own instantiation —
    // `Repository<User>` under `namespace app.storage` answers `"app.storage.User"`. Memoized
    // because every mapped row asks for it.
    fn model(): string {
        if self.model_name == "" {
            self.model_name = type_name::<T>()
        }
        return self.model_name
    }

    // --- Reads -------------------------------------------------------------------------------

    // Map one query row (`column -> value`) to the model, **recoverably**: round-trip the row through
    // JSON by the model's runtime name, then narrow the decoded value back to `T`. `Err(message)` is a
    // row the model cannot account for, and the message is the whole diagnosis (see `mismatch`).
    //
    // This is the recoverable half of the [aborting/recoverable door pair] with `map_row`, for the one
    // caller that legitimately reads a table it does not own and wants to decide for itself. The read
    // surface (`find`/`all`/`where`) goes through the aborting half, because for the app that owns both
    // the model and the migrations a row that will not decode is a deployment defect, not a condition.
    //
    // This is also where both halves of the type argument meet, and both are read off this repository's
    // own instantiation: `type_name::<T>()` supplies the registry key, `.as<T>()` recovers the static
    // type. Nothing above this line ever narrows a row again.
    fn try_map_row(row: Map<string, dyn>): Result<T, string> {
        text = json.stringify(row)
        return match json.decode_typed(self.model(), text) {
            Ok(v) => match v.as<T>() {
                some(model) => Ok(model),
                none => Err(
                    self.mismatch(text, "it decoded to a `${type_of(v)}`, which is not the model"),
                ),
            },
            // The decoder's own message already names the offending column and the expected-vs-found
            // types (`done: expected bool, found JSON number`) — carry it through rather than discard
            // it, since it is the whole diagnosis.
            Err(e) => Err(self.mismatch(text, e.message())),
        }
    }

    // Map one query row to the model, **aborting** if it does not decode — the aborting half of the
    // pair, and what every read goes through. Both halves report the identical message; this one just
    // stops the program with it instead of handing it back.
    fn map_row(row: Map<string, dyn>): T {
        return match self.try_map_row(row) {
            Ok(model) => model,
            Err(message) => panic(message),
        }
    }

    // The message for a row the model cannot account for: the table, the model, the decoder's own
    // column-and-types detail, and the row itself — everything needed to see which side is wrong
    // without reproducing the read.
    fn mismatch(row_json: string, detail: string): string {
        which = "a row of table `${self.tbl}` does not decode to the model `${self.model()}`"
        blame = "The table and the model disagree"
        return "para.db: ${which} — ${detail}. ${blame}; the row was ${row_json}"
    }

    // Map a batch of query rows to the model. Every row is mapped: the returned list is always as long
    // as the query's, and a row that is not a `T` aborts rather than shortening it (see `map_row`).
    fn map_rows(rows: List<Map<string, dyn>>): List<T> {
        mut out: List<T> = []
        for r in rows {
            out = out ~ [self.map_row(r)]
        }
        return out
    }

    // Find one row by primary key, mapped to the model. `none` means there is no such row — and only
    // that: a row that exists but does not decode aborts instead of impersonating a missing one.
    fn find(conn: Connection, id: dyn): ?T {
        q = table(self.tbl).filter(self.pk, "=", id).limit(1).select("*")
        rows = run(conn, q)
        if rows.len() == 0 {
            return none
        }
        return some(self.map_row(rows[0]))
    }

    // Every row in the table, mapped to the model.
    fn all(conn: Connection): List<T> {
        q = table(self.tbl).select("*")
        return self.map_rows(run(conn, q))
    }

    // Rows matching `col <op> value`, mapped to the model (reuses the DB1 builder's `filter`).
    fn where(conn: Connection, col: string, op: string, value: dyn): List<T> {
        q = table(self.tbl).filter(col, op, value).select("*")
        return self.map_rows(run(conn, q))
    }

    // --- Unit of work: stage changes now, flush them as one batch later. ---------------------

    // Stage an INSERT of `entity` (flushed on the next `flush`). Typed as the model, so a value of
    // any other type is rejected here rather than at flush time.
    fn add(entity: T): void {
        self.pending_new = self.pending_new ~ [entity]
    }

    // Stage an UPDATE of `entity` (matched by its primary key on flush).
    fn save(entity: T): void {
        self.pending_dirty = self.pending_dirty ~ [entity]
    }

    // Stage a DELETE of the row whose primary key is `id`. `dyn` on purpose: this takes a primary-key
    // VALUE, not a model, and the key's type is not the repository's type argument.
    fn remove(id: dyn): void {
        self.pending_remove = self.pending_remove ~ [id]
    }

    // Build the INSERT statement for one staged-new entity: all its columns/values.
    fn build_insert(entity: T): Query {
        m = columns_of(entity)
        cols = m.keys()
        mut vals: List<dyn> = []
        for c in cols {
            vals = vals ~ [m[c]]
        }
        return table(self.tbl).insert(cols, vals)
    }

    // Build the UPDATE statement for one staged-dirty entity: SET every non-pk column WHERE pk = its
    // own primary-key value.
    fn build_update(entity: T): Query {
        m = columns_of(entity)
        pk_value = m[self.pk]
        mut cols: List<string> = []
        mut vals: List<dyn> = []
        for c in m.keys() {
            if c != self.pk {
                cols = cols ~ [c]
                vals = vals ~ [m[c]]
            }
        }
        return table(self.tbl).filter(self.pk, "=", pk_value).update(cols, vals)
    }

    // Commit every staged change as one batch inside a single transaction, then clear the pending
    // lists. Returns the number of statements executed (inserts + updates + deletes).
    //
    // Error handling is structured with `if`/early-return in statement position (match arms are
    // expression-only): the driver surfaces a failed statement as a native error, so the happy path
    // runs BEGIN … COMMIT; a partial batch is undone by the transaction if COMMIT is never reached.
    fn flush(conn: Connection): int {
        mut count = 0
        conn.execute("BEGIN", [])
        for entity in self.pending_new {
            q = self.build_insert(entity)
            exec(conn, q)
            count = count + 1
        }
        for entity in self.pending_dirty {
            q = self.build_update(entity)
            exec(conn, q)
            count = count + 1
        }
        for id in self.pending_remove {
            q = table(self.tbl).filter(self.pk, "=", id).delete()
            exec(conn, q)
            count = count + 1
        }
        conn.execute("COMMIT", [])
        self.pending_new = []
        self.pending_dirty = []
        self.pending_remove = []
        return count
    }

    // Roll back every staged change without touching the database (drop the pending lists).
    fn discard(): void {
        self.pending_new = []
        self.pending_dirty = []
        self.pending_remove = []
    }
}

// Decompose a model entity into its columns and row values by round-tripping it through JSON:
// `to_json` (from `@derive(Serialize<Json>)`) then `parse` — the keys are the columns.
fn columns_of(entity: dyn): Map<string, dyn> {
    return json.parse(entity.to_json()).as<Map<string, dyn>>() ?? {}
}
