// A repository over a model declared in a NAMESPACED module.
//
//   noeta run examples/para-db-namespaced/main.noe
//
// A namespaced model's runtime identity is its qualified name (`demo.storage.Todo`), because that is
// the key the `@derive(Deserialize<Json>)` registry stores it under. A hand-written `"Todo"` would
// find nothing and every row would fail to map — silently, since a row that is not a `Todo` is
// dropped from a typed read.
//
// Naming the model as `Repository<Todo>`'s type argument is what removes that trap. The instance
// records the instantiation, so the repository resolves the qualified identity itself from the local
// name the `use` binds — this file never spells `"demo.storage.Todo"`. Move the model to another
// namespace or rename it and this keeps working.
use para.db
use para.db.repo.Repository
use demo.storage.Todo

conn = db.connect("sqlite::memory:")
conn.execute("CREATE TABLE todos (id INTEGER PRIMARY KEY, title TEXT, rank INTEGER)", [])

echo "model identity: ${type_name::<Todo>()}"

todos: Repository<Todo> = Repository.new("todos", "id")

todos.add(Todo { id: 1, title: "write the migration", rank: 1 })
todos.add(Todo { id: 2, title: "ship it", rank: 2 })
echo "flushed ${todos.flush(conn)} statements"

// `all()` answers `List<Todo>` — the repository's type argument, mapped inside the repository — so
// this renders the model directly. A row the registry could not resolve would be absent from the
// list, which is why the count is echoed alongside it.
fn render(t: Todo): string {
    return "  #${t.id} ${t.title} (rank=${t.rank})"
}

rows = todos.all(conn)
echo "mapped ${rows.len()} of 2 rows"
for t in rows {
    echo render(t)
}
