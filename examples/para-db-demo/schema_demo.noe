// The portable schema DSL (`para.db.schema`) — the DDL peer of the query builder. A schema statement
// is composed backend-neutrally and lowered by the connected driver, so ONE description creates the
// table on SQLite and on PostgreSQL: `id()` becomes `INTEGER PRIMARY KEY AUTOINCREMENT` here and
// `BIGSERIAL PRIMARY KEY` against a `postgres://` dsn, with no change to this program.
//
// The same source is what a `.schema` migration file holds — see `schema_migrate_demo.noe` for the
// durable, tracked route (which is what a real project uses). Run from the repo root:
//
//   noeta run examples/para-db-demo/schema_demo.noe
use para.db
use para.db.schema.{create_table, create_index, alter_table, drop_table, apply, source}
use para.db.query.{table, run, execute}

conn = db.connect("sqlite::memory:") // swap for "postgres://…" — nothing below changes

// 1. Describe the schema. Every builder renders schema-DSL source; `apply` lowers and runs it.
todos = create_table("todos")
    .id()
    .text("title").not_null()
    .bool("done").default(false)
    .timestamps()

owners = create_table("owners")
    .id()
    .text("email").not_null().unique()

applied = apply(conn, [owners.render(), todos.render()])
echo "applied ${applied} schema statement(s)"

// 2. The source a builder renders IS the body of a `.schema` migration — print it and paste it in.
echo "--- schema-DSL source ---"
echo source([todos.render()])

// 3. Evolve it: a new column and an index, described the same portable way.
apply(conn, [
    alter_table("todos").add_bigint("owner_id").references("owners", "id").render(),
    create_index("todos").column("done").render(),
])

// 4. It is an ordinary schema — the query builder writes and reads it as usual. `done` takes the
//    declared default, and `id` is auto-assigned by whichever mechanism the driver used. (A boolean
//    reads back as 0/1 on SQLite and true/false on Postgres: that is the driver's value mapping, not
//    something the schema layer can hide — see the README.)
execute(conn, table("owners").insert(["email"], ["ada@example.com"]))
execute(conn, table("todos").insert(["title", "owner_id"], ["write a migration", 1]))

rows = run(conn, table("todos").select("id, title, done, owner_id"))
for row in rows {
    id = row["id"]
    title = row["title"]
    done = row["done"]
    echo "  #${id} ${title} (done=${done})"
}

// 5. Dropping is portable too.
apply(conn, [drop_table("todos").if_exists().render()])
echo "dropped todos"

conn.close()
