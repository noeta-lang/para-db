// The para.db repository + unit-of-work (DB2), pure Noeta over the DB1 query builder and the DB0
// native SQLite driver. A `Repository<T>` maps rows <-> a typed model struct by reflection over JSON,
// stages inserts/updates/deletes during a request, and flushes them as one batch in a transaction.
//
//   noeta run examples/para-db-demo/repo_demo.noe
use para.db
use para.db.repo.Repository

// The model: deriving BOTH Serialize<Json> (model -> columns) and Deserialize<Json> (row -> model).
@derive(Serialize<Json>, Deserialize<Json>)
struct User {
    id: int
    name: string
    age: int
}

// Name of a `?User` result, or a fallback string. `find` answers the model, so there is nothing to
// narrow here — the only case left is "no such row".
fn name_of(found: ?User): string {
    return match found {
        some(user) => user.name,
        none => "none",
    }
}

// One-line description of a row. Its type is `User`, not `dyn`: the repository's type argument is
// what `all()` hands back.
fn describe(user: User): string {
    return "  #${user.id} ${user.name} (${user.age})"
}

conn = db.connect("sqlite::memory:")
conn.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)", [])

// Construct the repository over the model, its table, and its primary-key column. The model is the
// type argument, and the annotation is what records it: an instance keeps its type arguments, so the
// repository reads the model's *qualified* runtime identity — the key the decode registry actually
// holds — off itself. Move the model into a `namespace` or rename it and this keeps working.
users: Repository<User> = Repository.new("users", "id")

// --- Unit of work: stage two inserts, then flush them as one batch in a single transaction. -----
users.add(User { id: 1, name: "Ada", age: 36 })
users.add(User { id: 2, name: "Bob", age: 41 })
n = users.flush(conn)
echo "flushed ${n} statements"

// --- Read one back by primary key (find -> ?User; `none` when there is no such row). -------------
found = users.find(conn, 1)
found_name = name_of(found)
echo "find(1) -> ${found_name}"

// --- Read all, mapped to the model. --------------------------------------------------------------
everyone = users.all(conn)
count = everyone.len()
echo "all() -> ${count} users"
for e in everyone {
    echo describe(e)
}

// --- Update via the unit of work: stage a save, flush, read back. --------------------------------
users.save(User { id: 2, name: "Bob", age: 42 })
users.flush(conn)
bob = users.find(conn, 2)
bob_age = match bob {
    some(user) => user.age,
    none => 0,
}
echo "after save, #2 age -> ${bob_age}"

// --- Delete via the unit of work: stage a remove, flush, confirm gone. ----------------------------
users.remove(1)
users.flush(conn)
gone = users.find(conn, 1)
gone_name = name_of(gone)
echo "after remove, find(1) -> ${gone_name}"
final = users.all(conn).len()
echo "final count -> ${final}"

conn.close()
