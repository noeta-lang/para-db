// The para.db query builder (DB1) over the native SQLite driver: compose typed SELECT/INSERT with
// bound parameters (no string-splicing), then run them on a connection.
use para.db
use para.db.query.{table, run, execute}

conn = db.connect("sqlite::memory:")
conn.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)", [])

// INSERT via the builder.
ins = table("users").insert(["name", "age"], ["Ada", 36])
execute(conn, ins)
ins2 = table("users").insert(["name", "age"], ["Bob", 41])
execute(conn, ins2)
ins3 = table("users").insert(["name", "age"], ["Cy", 24])
execute(conn, ins3)

// SELECT with filter + order + limit via the builder.
q = table("users").filter("age", ">", 30).order("age", "asc").limit(10).select("name, age")
echo "sql: ${q.sql}"
rows = run(conn, q)
for r in rows {
    name = r["name"]
    age = r["age"]
    echo "${name} is ${age}"
}

// Conflict handling — the pair that makes a re-runnable seed portable. Both spellings are accepted
// verbatim by SQLite and PostgreSQL, so neither needs per-dialect lowering.
skip = table("users").insert_or_ignore(["id", "name", "age"], [1, "Ada", 36])
echo "skip: ${skip.sql}"
execute(conn, skip) // the row is already there: 0 rows affected, no error

up = table("users").upsert(["id", "name", "age"], [1, "Ada Lovelace", 37], ["id"])
echo "upsert: ${up.sql}"
execute(conn, up)
after = run(conn, table("users").filter("id", "=", 1).select("name, age"))
for r in after {
    name = r["name"]
    age = r["age"]
    echo "row 1 is now ${name}, ${age}"
}

// The exact SQL these emit is asserted in `conflict_demo.noe` — a wrong conflict clause is a
// portability bug, not a formatting one.
