// para.db.sql — a typed `@sql { … }` block tier (aether DB4), pure Noeta over the DB0 native driver.
//
// `@sql { SELECT * FROM users WHERE id = ${id} }` evaluates to a `Sql` value — the statement text
// with `?` placeholders plus the ordered bound parameters. A `${…}` hole is ALWAYS a bound
// parameter, never string-spliced into the SQL, so a statement built from untrusted input carries no
// injection risk by construction.
//
// The tier is enabled by the consuming project's manifest, NOT by importing `sql` — a file that
// imports nothing at all still type-checks and runs an `@sql { … }` block. Importing the handler
// only binds its name for a direct `sql(statics, holes)` call, which no caller needs; the demos
// import it out of habit, and it is harmless. What a caller does need from this module is
// `query`/`execute` (or the same pair as methods on the `Sql` the block returns).

use para.db.Connection

// A typed SQL statement: the text (with positional `?` placeholders) and its bound parameters.
//
// The two terminals are methods as well as the module-level functions below, so a statement can be
// run where it is written. `Query` carries the same pair for the same reason.
pub struct Sql {
    text: string
    params: List<dyn>

    // Run this statement as a query, returning its rows.
    fn query(conn: Connection): List<Map<string, dyn>> {
        return conn.query(self.text, self.params)
    }

    // Run this statement as a non-query (INSERT/UPDATE/DELETE/DDL), returning rows affected.
    fn execute(conn: Connection): int {
        return conn.execute(self.text, self.params)
    }
}

// The `@sql` expression tier handler. The block's verbatim SQL arrives as `statics` (one more than
// the holes); each `${…}` hole is a thunk evaluated here and appended as a bound parameter, with a
// `?` placeholder spliced into the text in its place.
@tier(sql, text: "sql", expr: Sql)
pub fn sql(statics: List<string>, holes: List<() -> dyn>): Sql {
    mut text = ""
    mut params: List<dyn> = []
    mut i = 0
    for s in statics {
        text = text ~ s
        if i < holes.len() {
            text = text ~ "?"
            h = holes[i]
            params = params ~ [h()]
        }
        i = i + 1
    }
    return Sql { text: text, params: params }
}

// Run a `@sql` statement as a query, returning its rows (`List<Map<string, dyn>>`).
pub fn query(conn: Connection, stmt: Sql): List<Map<string, dyn>> {
    return stmt.query(conn)
}

// Run a `@sql` statement as a non-query (INSERT/UPDATE/DELETE/DDL), returning rows affected.
pub fn execute(conn: Connection, stmt: Sql): int {
    return stmt.execute(conn)
}
