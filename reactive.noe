// para.db.reactive — the OPT-IN reactive layer over the repository (aether DB5).
//
// Reactivity is a choice, not a tax: the plain `Repository` (para.db.repo) stays non-reactive and
// zero-overhead. When you want the UI to track the database, you wrap it in a `LiveRepository` — its
// `all()` is a reactive `std.reactive` query that re-runs whenever the table changes, and its
// mutations notify so dependents wake. Internally it composes `db.watch` (a node in the reactive
// graph over the table's NOTIFY channel) with a plain repository — no new runtime, and the same
// reactive value a LiveView `view.expose(...)` diffs to the browser.
//
// Reactivity reaches beyond this repository's own writes, per driver:
//   * SQLite — a write through ANY connection in the process (this isolate or a sibling parallel-serve
//     worker) fires the connection's update hook and wakes the watch automatically. No trigger needed.
//     It does NOT cross to a separate OS process (SQLite has no server notify).
//   * PostgreSQL — a write from any process/worker wakes the UI if the database NOTIFYs the channel:
//     a trigger (`AFTER INSERT/UPDATE/DELETE … pg_notify('<table>')`) so ANY writer fires it, or
//     `conn.notify("<table>")` from each writer.
// Either way the app `pump()`s the live repository from its loop (e.g. the serve loop, alongside
// background tasks) to deliver them.

use para.db
use para.db.{Connection, Watch}
use db.repo.Repository
use std.reactive.computed

// A live, reactive repository over one model + table. Opt in by wrapping a plain `Repository<T>`.
// Reads become reactive queries; writes stage through the same unit-of-work and notify.
pub class LiveRepository<T> {
    repo: Repository<T>
    conn: Connection
    watch: Watch // over the table's NOTIFY channel
    channel: string // the NOTIFY channel (the table name)

    // Wrap a plain repository and a connection:
    //
    //   users: Repository<User> = Repository.new("users", "id")
    //   live: LiveRepository<User> = LiveRepository.new(users, conn)
    //
    // The repository comes in already built because the model rides on ITS instantiation, and a
    // type argument is recorded only where it is concrete — `Repository<T>` built here, with `T`
    // still a parameter, would carry nothing for `type_name::<T>()` to read. Wrapping is also what
    // the layer means: the plain repository keeps doing the mapping and the unit of work, and this
    // adds the reactive edges around it.
    //
    // The NOTIFY channel is the repository's table; the watch listens on it immediately.
    fn new(repo: Repository<T>, conn: Connection): LiveRepository<T> {
        return LiveRepository {
            repo: repo,
            conn: conn,
            watch: db.watch(conn, repo.tbl),
            channel: repo.tbl,
        }
    }

    // A REACTIVE query of every row, mapped to the model — re-runs whenever the table changes (the
    // watch wakes). Read it in an `effect`, or hand it to a LiveView `view.expose(...)`. The DB read
    // itself is not a reactive dependency; the `watch` is what invalidates it.
    fn all(): dyn {
        w = self.watch
        r = self.repo
        c = self.conn
        return computed(fn() {
            w.get()
            return r.all(c)
        })
    }

    // --- Writes: stage through the unit of work, then notify on flush so dependents wake. ---------

    fn add(entity: dyn): void {
        self.repo.add(entity)
    }

    fn save(entity: dyn): void {
        self.repo.save(entity)
    }

    fn remove(id: dyn): void {
        self.repo.remove(id)
    }

    // Commit the staged writes as one batch, then fire a notification so watchers (this app's live
    // queries, and — with a trigger — any external listener) wake. Returns the statement count.
    fn flush(): int {
        n = self.repo.flush(self.conn)
        self.conn.notify(self.channel)
        return n
    }

    // Pump the watch — deliver pending change notifications and wake the reactive queries if any
    // fired. Call it from the app's loop (the serve loop drives it alongside background tasks).
    fn pump(): bool {
        return self.watch.pump()
    }
}
