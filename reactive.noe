// para.db.reactive — the OPT-IN reactive layer over the repository (aether DB5).
//
// Reactivity is a choice, not a tax: the plain `Repository` (para.db.repo) stays non-reactive and
// zero-overhead. When you want the UI to track the database, you reach for a `LiveRepository` — its
// `all()` is a reactive `std.reactive` query that re-runs whenever the table changes, and its
// mutations notify so dependents wake. Internally it composes `db.watch` (a node in the reactive
// graph over the table's NOTIFY channel) with a plain repository — no new runtime, and the same
// reactive value a LiveView `view.expose(...)` diffs to the browser.
//
// Reactivity reaches beyond this repository's own writes, per driver:
//   * SQLite — a write through ANY connection in the process (this isolate or a sibling parallel-serve
//     worker) fires the connection's update hook and wakes the watch automatically. No trigger needed.
//     It does NOT cross to a separate OS process (SQLite has no server notify).
//   * PostgreSQL — a write from any process/worker wakes the UI if the database NOTIFYs the channel:
//     a trigger (`AFTER INSERT/UPDATE/DELETE … pg_notify('<table>')`) so ANY writer fires it, or
//     `conn.notify("<table>")` from each writer.
// Either way the app `pump()`s the live repository from its loop (e.g. the serve loop, alongside
// background tasks) to deliver them.

use para.db
use para.db.{Connection, Watch}
use db.repo.Repository
use std.reactive.computed

// A live, reactive repository over one model + table — a plain `Repository<T>` plus the reactive
// edges. Reads become reactive queries; writes stage through the same unit-of-work and notify.
pub class LiveRepository<T> {
    repo: Repository<T>
    conn: Connection
    watch: Watch // over the table's NOTIFY channel
    channel: string // the NOTIFY channel (the table name)

    // Name the model, the table and the connection — plus the primary-key column, unless the model
    // marks it `#[Key]` (`para.db.repo.Key`), which is where the inner repository reads it from:
    //
    //   live: LiveRepository<User> = LiveRepository.new("users", conn)
    //   live: LiveRepository<User> = LiveRepository.new("users", conn, "id")
    //
    // The connection comes SECOND — before the optional key column — because an argument with a
    // default has to come last, and the connection is the one this never works without.
    //
    // The inner `Repository<T>` is built here, from this instance's own `T`: an instance records its
    // type arguments at construction, and a generic type constructing another generic from its own
    // parameter passes them along, so the repository behind a `LiveRepository<User>` is a real
    // `Repository<User>` and resolves the model exactly as a hand-built one does. The layering is
    // unchanged — the plain repository still does the mapping and the unit of work, and this adds the
    // reactive edges around it — but a caller no longer assembles it in two steps.
    //
    // The NOTIFY channel is the table; the watch listens on it immediately.
    pub fn new(tbl: string, conn: Connection, pk: string = ""): LiveRepository<T> {
        return LiveRepository {
            repo: Repository.new(tbl, pk),
            conn: conn,
            watch: db.watch(conn, tbl),
            channel: tbl,
        }
    }

    // A REACTIVE query of every row, mapped to the model — re-runs whenever the table changes (the
    // watch wakes). Read it in an `effect`, or hand it to a LiveView `view.expose(...)`. The DB read
    // itself is not a reactive dependency; the `watch` is what invalidates it.
    //
    // `dyn` is the reactive HANDLE's own type (what `computed` answers), not a model-typing gap:
    // reading it yields what `Repository.all` yields, a `List<T>`.
    pub fn all(): dyn {
        w = self.watch
        r = self.repo
        c = self.conn
        return computed(fn() {
            w.get()
            return r.all(c)
        })
    }

    // --- Writes: stage through the unit of work, then notify on flush so dependents wake. ---------
    //
    // Typed as the model, exactly like the plain repository's — `T` is the same parameter, so the
    // wrapper neither widens nor re-checks anything the wrapped repository would not.

    pub fn add(entity: T): void {
        self.repo.add(entity)
    }

    // Insert NOW and answer the stored row (see `Repository.insert` — the door for a model whose key
    // the database assigns), then notify so watchers wake. It notifies on its own because it is not
    // staged: there is no `flush` after it to do it.
    fn insert(entity: T): T {
        stored = self.repo.insert(self.conn, entity)
        self.conn.notify(self.channel)
        return stored
    }

    fn save(entity: T): void {
        self.repo.save(entity)
    }

    // `dyn` on purpose: a primary-key VALUE, not a model. See `Repository.remove`.
    fn remove(id: dyn): void {
        self.repo.remove(id)
    }

    // Commit the staged writes as one batch, then fire a notification so watchers (this app's live
    // queries, and — with a trigger — any external listener) wake. Returns the statement count.
    pub fn flush(): int {
        n = self.repo.flush(self.conn)
        self.conn.notify(self.channel)
        return n
    }

    // Pump the watch — deliver pending change notifications and wake the reactive queries if any
    // fired. Call it from the app's loop (the serve loop drives it alongside background tasks).
    pub fn pump(): bool {
        return self.watch.pump()
    }
}
