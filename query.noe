// para.db.query — a general-purpose SQL query builder (aether DB1), pure Noeta over the native
// `para.db` driver. It composes a `Query` (statement text + ordered bound parameters) safely: every
// user value becomes a `?` placeholder + a binding, never string-spliced — so a query built from
// untrusted input carries no injection risk. The repository/unit-of-work layer (DB2) builds on this;
// it is also usable directly.

use para.db.Connection

// A composed SQL statement ready to run: the text (with `?` placeholders) and its bound parameters.
//
// The two terminals are methods so a built statement can be run where it is built —
// `table("todos").insert(cols, vals).execute(conn)` — and the module-level `run`/`execute` below
// are the same two operations spelled the other way round, for code that already holds a `Query`.
pub struct Query {
    sql: string
    params: List<dyn>

    // Run this query, returning its rows.
    pub fn run(conn: Connection): List<Map<string, dyn>> {
        return conn.query(self.sql, self.params)
    }

    // Run this statement as a non-query (INSERT/UPDATE/DELETE), returning rows affected.
    pub fn execute(conn: Connection): int {
        return conn.execute(self.sql, self.params)
    }
}

// A fluent query builder over a single table. Each method returns the builder, so calls chain:
// `table("users").filter("age", ">", 18).order("name", "asc").limit(20).select("id, name")`.
pub class Q {
    mut tbl: string
    mut conditions: List<string>
    mut bindings: List<dyn>
    mut orderings: List<string>
    mut lim: int

    pub fn new(name: string): Q {
        return Q { tbl: name, conditions: [], bindings: [], orderings: [], lim: 0 }
    }

    // Add a `WHERE col <op> ?` clause (ANDed with the others); `value` becomes a bound parameter.
    pub fn filter(col: string, op: string, value: dyn): Q {
        self.conditions = self.conditions ~ ["${col} ${op} ?"]
        self.bindings = self.bindings ~ [value]
        return self
    }

    // Add an `ORDER BY col <dir>` term (`dir` is "asc"/"desc").
    pub fn order(col: string, dir: string): Q {
        self.orderings = self.orderings ~ ["${col} ${dir}"]
        return self
    }

    // Limit the result set.
    pub fn limit(n: int): Q {
        self.lim = n
        return self
    }

    // The `WHERE …`/`ORDER BY …`/`LIMIT …` tail shared by SELECT/UPDATE/DELETE.
    fn tail(): string {
        mut sql = ""
        if self.conditions.len() > 0 {
            sql = sql ~ " WHERE " ~ self.conditions.join(" AND ")
        }
        if self.orderings.len() > 0 {
            sql = sql ~ " ORDER BY " ~ self.orderings.join(", ")
        }
        if self.lim > 0 {
            sql = sql ~ " LIMIT ${self.lim}"
        }
        return sql
    }

    // Build a `SELECT <cols> FROM <table> …`.
    pub fn select(cols: string): Query {
        sql = "SELECT ${cols} FROM ${self.tbl}${self.tail()}"
        return Query { sql: sql, params: self.bindings }
    }

    // Build a `DELETE FROM <table> WHERE …` (its bindings are this builder's filters).
    pub fn delete(): Query {
        sql = "DELETE FROM ${self.tbl}${self.tail()}"
        return Query { sql: sql, params: self.bindings }
    }

    // Build an `INSERT INTO <table> (cols) VALUES (?, …)`. `columns` names the columns; `values` are
    // the bound row values, positionally aligned.
    //
    // Naming NO column is a row made entirely of what the database assigns — every column of the
    // table is a `SERIAL` key, or carries a `DEFAULT`. That is `INSERT INTO <table> DEFAULT VALUES`,
    // accepted verbatim by SQLite and PostgreSQL, rather than the `(…) VALUES (…)` form with two
    // empty lists, which is a syntax error on both.
    pub fn insert(columns: List<string>, values: List<dyn>): Query {
        if columns.len() == 0 {
            return Query { sql: "INSERT INTO ${self.tbl} DEFAULT VALUES", params: [] }
        }
        placeholders = values.map(fn(v) => "?")
        col_list = columns.join(", ")
        value_list = placeholders.join(", ")
        sql = "INSERT INTO ${self.tbl} (${col_list}) VALUES (${value_list})"
        return Query { sql: sql, params: values }
    }

    // Build an `INSERT … RETURNING <returning>` — an insert that **answers the row it wrote**. It is
    // how a caller learns what the database assigned (a `SERIAL`/`AUTOINCREMENT` key, a
    // `DEFAULT now()` timestamp) without a second round trip and without a driver-specific
    // last-inserted-id call, so it stays one statement even under concurrent writers.
    //
    // Portable with no per-dialect lowering, like the conflict clauses above: PostgreSQL has had
    // `RETURNING` throughout, SQLite since 3.35 (2021). Run it with `run`, not `execute` — it answers
    // ROWS, which is the whole point.
    pub fn insert_returning(columns: List<string>, values: List<dyn>, returning: string = "*"): Query {
        base = self.insert(columns, values)
        return Query { sql: base.sql ~ " RETURNING ${returning}", params: base.params }
    }

    // Build an idempotent `INSERT … ON CONFLICT DO NOTHING`: the row is inserted unless it would
    // violate a unique/primary-key constraint, in which case the statement is a no-op (0 rows
    // affected) instead of an error. Re-running it is therefore safe — the idiom a **seed** wants.
    //
    // The emitted conflict clause is portable with no per-dialect lowering: SQLite and PostgreSQL
    // both accept the untargeted `ON CONFLICT DO NOTHING`. (The SQLite-only `INSERT OR IGNORE`
    // spelling of the same idea is a hard syntax error on PostgreSQL — this builder never emits it.)
    pub fn insert_or_ignore(columns: List<string>, values: List<dyn>): Query {
        guard_conflict_columns(columns)
        base = self.insert(columns, values)
        return Query { sql: base.sql ~ " ON CONFLICT DO NOTHING", params: base.params }
    }

    // Build an **upsert**: `INSERT … ON CONFLICT (<conflict>) DO UPDATE SET c = excluded.c, …`. The
    // row is inserted when it is new, and every column that is *not* part of `conflict` is
    // overwritten from the incoming row (`excluded`) when it already exists. `conflict` names the
    // columns of the unique constraint that decides "already exists" (typically the primary key), so
    // it may not be empty — the conflict target is what makes `DO UPDATE` legal on both backends.
    //
    // Like `insert_or_ignore`, what it emits is accepted verbatim by SQLite and PostgreSQL, so an
    // upsert seed is portable. When `conflict` covers *every* inserted column there is nothing left
    // to assign, and the statement degrades to `ON CONFLICT DO NOTHING` — the same meaning, since
    // overwriting a row with the values it already has is a no-op, and an empty `SET` is a syntax
    // error on both backends.
    pub fn upsert(columns: List<string>, values: List<dyn>, conflict: List<string>): Query {
        if conflict.len() == 0 {
            panic("para.db.query: upsert needs at least one conflict column (the unique/primary-key columns that decide whether the row already exists); use insert_or_ignore for an untargeted skip")
        }
        guard_conflict_columns(columns)
        base = self.insert(columns, values)
        mut assignments: List<string> = []
        for c in columns {
            if !conflict.contains(c) {
                assignments = assignments ~ ["${c} = excluded.${c}"]
            }
        }
        if assignments.len() == 0 {
            return Query { sql: base.sql ~ " ON CONFLICT DO NOTHING", params: base.params }
        }
        target = conflict.join(", ")
        set_list = assignments.join(", ")
        sql = base.sql ~ " ON CONFLICT (${target}) DO UPDATE SET ${set_list}"
        return Query { sql: sql, params: base.params }
    }

    // Build an `UPDATE <table> SET col = ?, … WHERE …`. `columns`/`values` are the SET assignments;
    // the WHERE bindings (this builder's filters) follow the SET bindings in order.
    pub fn update(columns: List<string>, values: List<dyn>): Query {
        assignments = columns.map(fn(c) => "${c} = ?")
        set_list = assignments.join(", ")
        clause = self.tail()
        sql = "UPDATE ${self.tbl} SET ${set_list}${clause}"
        return Query { sql: sql, params: values ~ self.bindings }
    }
}

// A conflict clause needs a row to conflict about. The all-defaults insert (`DEFAULT VALUES`, the
// empty-`columns` form above) takes no `ON CONFLICT` on SQLite at all — its grammar allows an upsert
// clause only after `VALUES`/`SELECT` — so the two are refused together here rather than composed
// into a statement that runs on one backend and is a syntax error on the other.
fn guard_conflict_columns(columns: List<string>): void {
    if columns.len() == 0 {
        panic("para.db.query: a conflict clause needs at least one inserted column — a row made entirely of database-assigned columns has nothing to conflict about; use insert(...) for the `DEFAULT VALUES` form")
    }
}

// Start a query on `name`.
pub fn table(name: string): Q {
    return Q.new(name)
}

// Run a composed query on a connection, returning its rows (a `List<Map<string, dyn>>`).
pub fn run(conn: Connection, q: Query): List<Map<string, dyn>> {
    return q.run(conn)
}

// Execute a composed non-query statement (INSERT/UPDATE/DELETE), returning rows affected.
//
// Named for what `Connection.execute` is named — `para.db.sql.execute` is the same operation over a
// `@sql` statement, so the two doors into the driver read the same. It was `exec` through 0.3.
pub fn execute(conn: Connection, q: Query): int {
    return q.execute(conn)
}
